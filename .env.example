# Copy to .env (cp .env.example .env). Node reads it with --env-file-if-exists.
PORT=3000
# Where PGlite stores the database. Delete the folder (npm run db:reset) to start over.
DATABASE_DIR=.data/pgdata
# Required by PUT /api/flags/:key (the `npm run flag` CLI sends it). Change it.
ADMIN_TOKEN=change-me
