{
  "name": "remote-config-example",
  "version": "1.0.0",
  "description": "Remote config with { key, value } rows in Postgres. The value is always a string; the type is detected from it.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.ts && node --env-file-if-exists=.env scripts/migrate.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "flag": "node --env-file-if-exists=.env scripts/flag.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
